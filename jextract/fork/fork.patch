-            appendIndentedLines("public static final ValueLayout.OfInt C_LONG = (ValueLayout.OfInt) Linker.nativeLinker().canonicalLayouts().get(\"long\");");
+            // LOCAL PATCH (box2d-java fork): emit a fixed 4-byte int rather than
+            // (ValueLayout.OfInt) canonicalLayouts().get("long"). The stock cast is only
+            // valid on LLP64; when these Windows-generated bindings are loaded on LP64
+            // (Linux/macOS) "long" resolves to OfLong and the cast throws
+            // ClassCastException at class init. JAVA_INT keeps the OfInt type (downstream
+            // generated code still compiles) and equals Windows' 4-byte long, so one
+            // generated binding set loads on every 64-bit target. Re-apply after upgrades.
+            appendIndentedLines("public static final ValueLayout.OfInt C_LONG = ValueLayout.JAVA_INT;");
             appendIndentedLines("public static final ValueLayout.OfDouble C_LONG_DOUBLE = (ValueLayout.OfDouble) Linker.nativeLinker().canonicalLayouts().get(\"double\");");
